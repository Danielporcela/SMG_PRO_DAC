"""Rotas que entregam as telas HTML.

Toda página exige sessão ativa e, agora, o nível "visualizar" (ou superior)
na tela correspondente da matriz de permissões — quem não tem acesso é
levado para a primeira tela liberada, ou para um aviso caso não tenha
nenhuma.
"""
from functools import wraps

from flask import Blueprint, redirect, render_template, session, url_for

from extensions import db
from models import Usuario

bp_paginas = Blueprint("paginas", __name__)

# Telas de administração do sistema (login de outras pessoas, auditoria,
# avisos por e-mail): continuam exclusivas de quem tem perfil "admin",
# fora da matriz de permissões por tela.
TELAS_SOMENTE_ADMIN = {"usuarios", "auditoria", "notificacoes"}


def _usuario_logado():
    if not session.get("usuario_id"):
        return None
    return db.session.get(Usuario, session["usuario_id"])


def exige_tela(tela, nivel_minimo="visualizar"):
    """Protege uma página: exige sessão e o nível informado na tela `tela`.

    Quem está logado mas não tem acesso é redirecionado para a primeira
    tela que ele pode ver, evitando um 403 seco assim que entra no sistema.
    """
    def decorator(f):
        @wraps(f)
        def wrapper(*args, **kwargs):
            if not session.get("usuario_id"):
                return redirect(url_for("auth.login"))

            if tela in TELAS_SOMENTE_ADMIN:
                liberado = session.get("perfil") == "admin"
            else:
                nivel_atual = (session.get("permissoes") or {}).get(tela, "nenhum")
                if session.get("perfil") == "admin":
                    nivel_atual = "editar"
                pesos = {"nenhum": 0, "visualizar": 1, "editar": 2}
                liberado = pesos.get(nivel_atual, 0) >= pesos.get(nivel_minimo, 1)

            if not liberado:
                usuario = _usuario_logado()
                primeira = usuario.primeira_tela_liberada() if usuario else None
                if primeira and primeira != tela:
                    return redirect(url_for(f"paginas.{primeira}"))
                return render_template(
                    "erro.html", codigo=403,
                    mensagem="Você ainda não tem nenhuma tela liberada. "
                             "Fale com o administrador do sistema."), 403
            return f(*args, **kwargs)
        return wrapper
    return decorator


def _tela(rota, template, pagina, endpoint=None, nivel_minimo="visualizar"):
    @bp_paginas.get(rota, endpoint=endpoint or pagina)
    @exige_tela(pagina, nivel_minimo)
    def view(template=template, pagina=pagina):
        return render_template(template, pagina=pagina)
    return view


_tela("/", "dashboard.html", "dashboard")
_tela("/alertas", "alertas.html", "alertas")
_tela("/veiculos", "veiculos.html", "veiculos")
_tela("/motoristas", "motoristas.html", "motoristas")
_tela("/fornecedores", "fornecedores.html", "fornecedores")
_tela("/manutencao", "manutencao.html", "manutencao")
_tela("/compras", "compras.html", "compras")
_tela("/combustivel", "combustivel.html", "combustivel")
_tela("/pneus", "pneus.html", "pneus")
_tela("/estoque", "estoque.html", "estoque")
_tela("/funcionarios", "funcionarios.html", "funcionarios")
_tela("/uniformes", "uniformes.html", "uniformes")
_tela("/orcamento", "orcamento.html", "orcamento")
_tela("/ranking", "ranking.html", "ranking")
_tela("/relatorios", "relatorios.html", "relatorios")
_tela("/importacao", "importacao.html", "importacao")

# Telas exclusivas do administrador — fora da matriz de permissões.
_tela("/usuarios", "usuarios.html", "usuarios")
_tela("/auditoria", "auditoria.html", "auditoria")
_tela("/notificacoes", "notificacoes.html", "notificacoes")
